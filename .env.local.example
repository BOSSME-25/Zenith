# Zenith College and Career Prep — environment variables
# Copy this file to .env.local and fill in real values before deploying.
# The site will build and run with these unset, but database persistence
# and email notifications will be no-ops.

# ─────────────────────────────────────────────────────────────────────────────
# Postgres (Vercel Postgres / any standard Postgres connection)
# Provided automatically when you link a Postgres marketplace integration on
# Vercel. For local dev, create a database (e.g. via Neon, Supabase, or local
# Postgres) and paste the connection string.
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# ─────────────────────────────────────────────────────────────────────────────
# Resend (transactional email)
# Get an API key at https://resend.com/api-keys
# EMAIL_FROM must be a verified sender on your Resend account.
# NOTIFICATION_EMAIL receives every form submission notification.
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Zenith College and Career Prep <noreply@yourdomain.org>"
NOTIFICATION_EMAIL=

# ─────────────────────────────────────────────────────────────────────────────
# Admin password
# Used by /admin/login and /api/init. Choose a strong value in production.
# AUTH_SECRET is optional; if omitted, ADMIN_PASSWORD is also used to sign
# the auth cookie. For production, set AUTH_SECRET to an independent random
# value so rotating the admin password does not invalidate all sessions.
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=
AUTH_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Public site URL (used for metadata + canonical URLs)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://zenithprep.org
