# Zenith College and Career Prep — environment variables
# Copy this file to .env.local and fill in real values before deploying.
# The site will build and run with these unset, but database persistence
# and email notifications will be no-ops.

# ─────────────────────────────────────────────────────────────────────────────
# Postgres (Vercel Postgres / any standard Postgres connection)
# Provided automatically when you link a Postgres marketplace integration on
# Vercel. For local dev, create a database (e.g. via Neon, Supabase, or local
# Postgres) and paste the connection string.
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# ─────────────────────────────────────────────────────────────────────────────
# Resend (transactional email)
# Get an API key at https://resend.com/api-keys
# EMAIL_FROM must be a verified sender on your Resend account.
# NOTIFICATION_EMAIL receives every form submission notification.
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Zenith College and Career Prep <noreply@yourdomain.org>"
NOTIFICATION_EMAIL=

# ─────────────────────────────────────────────────────────────────────────────
# Admin password
# Used by /admin/login and /api/init. Choose a strong value in production.
# AUTH_SECRET is optional; if omitted, ADMIN_PASSWORD is also used to sign
# the auth cookie. For production, set AUTH_SECRET to an independent random
# value so rotating the admin password does not invalidate all sessions.
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=
AUTH_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Vercel Blob (file storage)
# Provided automatically when you add a Blob store to the Vercel project.
# Used for admin image uploads and for uploading Jay's welcome video
# (see scripts/upload-welcome-video.mjs / `npm run upload:video`).
# ─────────────────────────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Welcome video (Jay) — served from Vercel Blob in production.
# Run `npm run upload:video` to upload public/video/jay-welcome.mov to Blob,
# then paste the printed URL here. If unset, the app falls back to the local
# file at /video/jay-welcome.mov (handy for development).
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WELCOME_VIDEO_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Server Actions encryption key
# Pins a stable key so Next.js Server Actions (admin forms: newsletter, updates,
# etc.) keep working across deployments. Without it, each build generates a new
# key and a form opened before a redeploy fails to submit ("Failed to find
# Server Action"), losing unsaved work. Generate with: openssl rand -base64 32
# Set the SAME value across all environments and keep it permanently.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Public site URL (used for metadata + canonical URLs)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://zenithprep.org
